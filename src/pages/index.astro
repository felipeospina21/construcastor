---
import Layout from "../layouts/Layout.astro";
import Carousel from "../components/Carousel.astro";
import About from "../components/About.astro";
import HowItWorks from "../components/HowItWorks.astro";
import GoogleMap from "../components/GoogleMap.astro";
import { getCollection } from "astro:content";

// "Nuestros Aliados" grid is driven by the same brand collection as the
// catalog — add a brand markdown file and it appears here automatically.
const aliados = (await getCollection("brands")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);

const desktopSlides = [
  { src: "/images/s1.jpg", alt: "foto" },
  { src: "/images/s2.jpg", alt: "foto" },
  { src: "/images/s3.jpg", alt: "foto" },
  { src: "/images/s4.jpg", alt: "foto" },
  { src: "/images/s5.jpg", alt: "foto" },
  { src: "/images/s6.jpg", alt: "foto" },
];
const mobileSlides = [
  { src: "/images/v1.jpg", alt: "foto" },
  { src: "/images/v2.jpg", alt: "foto" },
  { src: "/images/v3.jpg", alt: "foto" },
  { src: "/images/v4.jpg", alt: "foto" },
  { src: "/images/v5.jpg", alt: "foto" },
  { src: "/images/v6.jpg", alt: "foto" },
];
---

<Layout title="Inicio">
  <!-- Responsive carousel: mobile set below sm, desktop set from sm up -->
  <div class="mx-auto w-full max-w-carousel">
    <div class="block sm:hidden">
      <Carousel slides={mobileSlides} interval={5000} />
    </div>
    <div class="hidden sm:block">
      <Carousel slides={desktopSlides} interval={5000} />
    </div>
  </div>

  <About />

  <!-- Nuestros Aliados -->
  <section class="mx-auto my-8 w-full max-w-[1100px] px-2 sm:my-16">
    <div class="flex justify-center">
      <h1 class="text-3xl font-bold">Nuestros Aliados</h1>
    </div>

    <ul
      class="mx-auto my-10 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5"
    >
      {
        aliados.map((brand) => (
          <li>
            <a
              href={`/catalogo/${brand.slug}`}
              class="flex h-28 items-center justify-center rounded-lg border border-gray-200 bg-white p-4 transition-shadow hover:shadow-md"
              title={brand.data.title}
            >
              <img
                src={brand.data.brandLogo}
                alt={`Logo ${brand.data.title}`}
                class="max-h-full max-w-full object-contain"
                loading="lazy"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <HowItWorks />
  <GoogleMap />
</Layout>
