---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Página no encontrada"
  description="La página que buscas no existe en Construcastor."
>
  <section class="mx-auto my-20 max-w-[600px] px-4 text-center">
    <p class="text-6xl font-bold text-brand-blue">404</p>
    <h1 class="mt-4 text-2xl font-bold">Página no encontrada</h1>
    <p class="mt-3 text-gray-600">
      Lo sentimos, la página que buscas no existe o fue movida.
    </p>
    <a
      href="/"
      class="mt-8 inline-block rounded-lg bg-brand-blue px-6 py-3 font-semibold text-white transition-opacity hover:opacity-90"
    >
      Volver al inicio
    </a>
  </section>
</Layout>
