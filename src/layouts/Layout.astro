---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
}

const siteTitle = "Construcastor";
const siteDescription = "Almacén de materiales para construcción";
const author = "@felipeospina21";

const { title, description = siteDescription } = Astro.props;
const fullTitle = `${title} | ${siteTitle}`;
const GTAG_ID = "G-J47DBKB66Z";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/images/logo-castor.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:creator" content={author} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Web manifest / theme -->
    <meta name="theme-color" content="#663399" />

    <!-- Google Analytics (gtag) -->
    <script
      is:inline
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${GTAG_ID}`}></script>
    <script is:inline define:vars={{ GTAG_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", GTAG_ID, { anonymize_ip: true });
    </script>
  </head>
  <body>
    <Header />
    <main class="mx-2 max-w-site xl:mx-auto">
      <slot />
    </main>
    <Footer />
  </body>
</html>
