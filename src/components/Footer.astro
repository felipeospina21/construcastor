---
// Ports Footer.js + OpenHours.js + ContactInfo.js + Adress.js + Phone.js + Social.js
// react-icons replaced with inline SVG (Feather/FontAwesome-equivalent paths).
---

<footer
  class="mx-auto max-w-[1850px] bg-brand-yellow p-2 text-sm sm:p-4"
>
  <div class="mx-auto max-w-[500px]">
    <div class="grid grid-cols-[1fr_0.5fr] gap-x-2 gap-y-5 sm:grid-cols-[1fr_0.3fr]">
      <!-- OpenHours -->
      <div class="col-span-2 mx-auto max-w-[250px]">
        <table class="w-full text-sm">
          <thead>
            <tr>
              <th class="text-left font-bold">Horarios</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="py-[0.2rem] pl-[0.3rem]">Lunes a Viernes</td>
              <td class="py-[0.2rem]">8:00am</td>
              <td class="py-[0.2rem]">-</td>
              <td class="py-[0.2rem]">5:00pm</td>
            </tr>
            <tr>
              <td class="py-[0.2rem] pl-[0.3rem]">Sábados</td>
              <td class="py-[0.2rem]">8:00am</td>
              <td class="py-[0.2rem]">-</td>
              <td class="py-[0.2rem]">1:30pm</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- ContactInfo: Adress + Phone -->
      <div class="col-span-2">
        <div class="grid grid-cols-[1fr_0.5fr] sm:grid-cols-[1fr_0.3fr]">
          <!-- Adress -->
          <div class="grid grid-cols-[0.1fr_1fr] gap-1 sm:grid-cols-[0.08fr_1fr]">
            <div class="row-end-2">
              <!-- location icon -->
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <p>Calle 48 (Pichincha) #55-59</p>
            <p class="col-start-2">Medellín, Colombia</p>
          </div>

          <!-- Phone -->
          <div class="grid grid-cols-[0.1fr_1fr] gap-1 sm:grid-cols-[0.3fr_1fr]">
            <div class="row-end-1">
              <!-- phone icon -->
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <p>512 93 28</p>
            <div class="row-end-2">
              <!-- whatsapp icon -->
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l119.3-31.3c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 222.1-99.6 222.1-222 0-59.3-23.2-115-65.2-156.6zM223.9 438.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-70.8 18.6L71 357.4l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 186.3-186.6 186.3zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
            </div>
            <p class="col-start-2">321 858 9931</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

<!-- Social + credit -->
<div class="m-2 flex flex-col items-center text-xs">
  <div class="m-[0.65rem_auto_1.5rem_auto] flex h-full items-center">
    <a href="mailto:elcastor@une.net.co" aria-label="Correo electrónico" class="mx-4">
      <!-- envelope icon -->
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-8 w-8" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
    </a>
    <a
      href="http://api.whatsapp.com/send?phone=573218589931"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="WhatsApp"
      class="mx-4"
    >
      <!-- whatsapp icon -->
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill="currentColor" class="h-8 w-8" aria-hidden="true"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l119.3-31.3c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 222.1-99.6 222.1-222 0-59.3-23.2-115-65.2-156.6zM223.9 438.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-70.8 18.6L71 357.4l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 186.3-186.6 186.3zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
