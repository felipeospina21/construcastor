---
// Lightweight carousel replacing react-responsive-carousel.
// Autoplay + infinite loop + swipe, zero framework runtime.
// Accessible: labelled region, pause/play control, honors prefers-reduced-motion.
// Each slide's `src` may be a string (public path, e.g. CMS gallery) or an
// imported ImageMetadata object (optimized at build time via astro:assets).
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Slide {
  src: string | ImageMetadata;
  alt: string;
}
interface Props {
  slides: Slide[];
  interval?: number;
  showArrows?: boolean;
  slideClass?: string; // classes applied to each slide wrapper (e.g. heights)
  imgClass?: string; // classes applied to each <img>
  label?: string; // accessible name for the carousel region
  sizes?: string; // responsive sizes hint for optimized images
}

const {
  slides,
  interval = 5000,
  showArrows = false,
  slideClass = "h-[300px] sm:h-[400px] md:h-[500px] lg:h-[650px] w-full",
  imgClass = "h-full w-full object-cover",
  label = "Carrusel de imágenes",
  sizes = "100vw",
} = Astro.props;

const uid = "car-" + Math.random().toString(36).slice(2, 9);
---

<div
  class="carousel group relative w-full overflow-hidden"
  data-carousel
  data-interval={interval}
  id={uid}
  role="region"
  aria-roledescription="carrusel"
  aria-label={label}
>
  <div
    class="carousel-track flex transition-transform duration-500 ease-in-out"
    data-track
    aria-live="polite"
  >
    {
      slides.map((slide, i) => (
        <div
          class={`carousel-slide shrink-0 grow-0 basis-full ${slideClass}`}
          role="group"
          aria-roledescription="diapositiva"
          aria-label={`${i + 1} de ${slides.length}`}
        >
          {typeof slide.src === "string" ? (
            <img
              src={slide.src}
              alt={slide.alt}
              class={imgClass}
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : "auto"}
            />
          ) : (
            <Image
              src={slide.src}
              alt={slide.alt}
              class={imgClass}
              widths={[640, 960, 1280, 1750]}
              sizes={sizes}
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : "auto"}
            />
          )}
        </div>
      ))
    }
  </div>

  {
    slides.length > 1 && (
      <button
        type="button"
        data-toggle
        aria-label="Pausar"
        class="absolute bottom-2 right-2 z-10 rounded-full bg-black/40 p-2 text-white hover:bg-black/60"
      >
        <svg data-icon-pause xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4"><rect x="6" y="5" width="4" height="14"/><rect x="14" y="5" width="4" height="14"/></svg>
        <svg data-icon-play xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="hidden h-4 w-4"><polygon points="6 4 20 12 6 20 6 4"/></svg>
      </button>
    )
  }

  {
    showArrows && slides.length > 1 && (
      <>
        <button
          type="button"
          data-prev
          aria-label="Anterior"
          class="absolute left-2 top-1/2 z-10 -translate-y-1/2 rounded-full bg-black/40 p-2 text-white hover:bg-black/60"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button
          type="button"
          data-next
          aria-label="Siguiente"
          class="absolute right-2 top-1/2 z-10 -translate-y-1/2 rounded-full bg-black/40 p-2 text-white hover:bg-black/60"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </>
    )
  }
</div>

<script>
  function initCarousel(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>("[data-track]");
    if (!track) return;
    const slides = Array.from(track.children) as HTMLElement[];
    const total = slides.length;
    if (total <= 1) return;

    const interval = Number(root.dataset.interval) || 5000;
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    let index = 0;
    let timer: number | undefined;
    let playing = false;

    const render = () => {
      track.style.transform = `translateX(-${index * 100}%)`;
    };
    const go = (next: number) => {
      index = (next + total) % total; // infinite loop
      render();
    };
    const next = () => go(index + 1);
    const prev = () => go(index - 1);

    const toggleBtn = root.querySelector<HTMLButtonElement>("[data-toggle]");
    const iconPause = root.querySelector<SVGElement>("[data-icon-pause]");
    const iconPlay = root.querySelector<SVGElement>("[data-icon-play]");

    const reflectState = () => {
      if (!toggleBtn) return;
      toggleBtn.setAttribute("aria-label", playing ? "Pausar" : "Reproducir");
      iconPause?.classList.toggle("hidden", !playing);
      iconPlay?.classList.toggle("hidden", playing);
    };

    const start = () => {
      if (reduceMotion) return; // respect user preference: no autoplay
      stop();
      timer = window.setInterval(next, interval);
      playing = true;
      reflectState();
    };
    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = undefined;
      playing = false;
      reflectState();
    };

    root.querySelector("[data-next]")?.addEventListener("click", () => {
      next();
      if (!reduceMotion) start();
    });
    root.querySelector("[data-prev]")?.addEventListener("click", () => {
      prev();
      if (!reduceMotion) start();
    });
    toggleBtn?.addEventListener("click", () => {
      playing ? stop() : start();
    });

    // Pause on hover (only meaningful when autoplaying)
    root.addEventListener("mouseenter", () => {
      if (playing) stop();
    });
    root.addEventListener("mouseleave", () => {
      if (!reduceMotion) start();
    });

    // Swipe
    let startX = 0;
    root.addEventListener(
      "touchstart",
      (e) => {
        startX = e.touches[0].clientX;
      },
      { passive: true }
    );
    root.addEventListener(
      "touchend",
      (e) => {
        const dx = e.changedTouches[0].clientX - startX;
        if (Math.abs(dx) > 40) {
          dx < 0 ? next() : prev();
          if (!reduceMotion) start();
        }
      },
      { passive: true }
    );

    render();
    // Hide the pause/play control entirely when motion is reduced.
    if (reduceMotion) {
      toggleBtn?.classList.add("hidden");
    } else {
      start();
    }
  }

  document
    .querySelectorAll<HTMLElement>("[data-carousel]")
    .forEach((el) => initCarousel(el));
</script>
