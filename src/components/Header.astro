---
// Sticky header — three-zone layout with:
//   #7 Contacto destination
//   #6 accessible mobile hamburger menu
//   #5 shrink-on-scroll (condenses after scrolling down)
const navLinks = [
  { to: "/", label: "Inicio" },
  { to: "/catalogo", label: "Catálogo" },
  { to: "/contacto", label: "Contacto" },
];

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (to: string) =>
  to === "/" ? path === "/" : path === to || path.startsWith(to + "/");

const WHATSAPP = "http://api.whatsapp.com/send?phone=573218589931";

const linkClass = (active: boolean) =>
  [
    "rounded px-2 py-1 font-semibold text-brand-blue outline-none transition",
    "decoration-2 underline-offset-4 hover:underline",
    "focus-visible:ring-2 focus-visible:ring-brand-blue",
    active ? "underline" : "no-underline",
  ].join(" ");
---

<header
  id="site-header"
  class="sticky top-0 z-30 mx-auto max-w-carousel bg-brand-yellow transition-all duration-300 sm:h-28 sm:[&.scrolled]:h-16"
>
  <div
    class="mx-auto grid max-w-carousel grid-cols-[1fr_auto_1fr] items-center gap-2 px-2 pt-2 sm:h-full sm:px-4 sm:pt-0"
  >
    <!-- Left: logo + brand -->
    <a
      href="/"
      aria-label="Construcastor — inicio"
      class="flex items-center gap-3 rounded outline-none focus-visible:ring-2 focus-visible:ring-brand-blue"
    >
      <img
        src="/images/logo-castor.svg"
        alt="Construcastor logo"
        class="h-[60px] w-[60px] rounded-full transition-all duration-300 sm:h-[76px] sm:w-[76px] sm:[.scrolled_&]:h-[44px] sm:[.scrolled_&]:w-[44px]"
        width="76"
        height="76"
      />
      <span class="flex flex-col leading-tight">
        <span class="text-xl font-bold text-brand-blue sm:text-2xl lg:text-3xl">
          CONSTRUCASTOR
        </span>
        <span
          class="hidden text-xs font-bold text-brand-blue sm:block sm:[.scrolled_&]:hidden"
        >
          Su mejor proveedor
        </span>
      </span>
    </a>

    <!-- Center: primary nav (desktop) -->
    <nav
      class="hidden items-center justify-center gap-6 sm:flex"
      aria-label="Principal"
    >
      {
        navLinks.map((link) => (
          <a
            href={link.to}
            aria-current={isActive(link.to) ? "page" : undefined}
            class={linkClass(isActive(link.to))}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- Right: WhatsApp CTA (desktop) + hamburger (mobile) -->
    <div class="flex items-center justify-self-end gap-2">
      <a
        href={WHATSAPP}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden items-center gap-1.5 rounded-full bg-brand-blue px-3 py-1.5 text-sm font-semibold text-white outline-none transition hover:opacity-90 focus-visible:ring-2 focus-visible:ring-brand-blue focus-visible:ring-offset-2 focus-visible:ring-offset-brand-yellow sm:inline-flex"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l119.3-31.3c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 222.1-99.6 222.1-222 0-59.3-23.2-115-65.2-156.6zM223.9 438.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-70.8 18.6L71 357.4l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 186.3-186.6 186.3zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
        Contáctanos
      </a>

      <!-- Hamburger (mobile only) -->
      <button
        type="button"
        id="nav-toggle"
        class="rounded p-2 text-brand-blue outline-none focus-visible:ring-2 focus-visible:ring-brand-blue sm:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg data-icon-open xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-7 w-7" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        <svg data-icon-close xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="hidden h-7 w-7" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile slide-down panel -->
  <nav
    id="mobile-menu"
    aria-label="Menú móvil"
    class="hidden border-t border-brand-blue/10 bg-brand-yellow sm:hidden"
  >
    <ul class="flex flex-col px-4 py-2">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.to}
              aria-current={isActive(link.to) ? "page" : undefined}
              class={`block py-2 ${linkClass(isActive(link.to))}`}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="py-2">
        <a
          href={WHATSAPP}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-full bg-brand-blue px-3 py-1.5 text-sm font-semibold text-white"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l119.3-31.3c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 222.1-99.6 222.1-222 0-59.3-23.2-115-65.2-156.6zM223.9 438.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-70.8 18.6L71 357.4l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 186.3-186.6 186.3zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
          Contáctanos
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  // #6 Mobile hamburger toggle
  const header = document.getElementById("site-header");
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = toggle?.querySelector<SVGElement>("[data-icon-open]");
  const iconClose = toggle?.querySelector<SVGElement>("[data-icon-close]");

  function setMenu(open: boolean) {
    if (!toggle || !menu) return;
    menu.classList.toggle("hidden", !open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
  }

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    setMenu(!open);
  });

  // Close on Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setMenu(false);
  });

  // Close when a menu link is clicked
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => setMenu(false))
  );

  // Close when resizing up to desktop
  window.matchMedia("(min-width: 640px)").addEventListener("change", (e) => {
    if (e.matches) setMenu(false);
  });

  // #5 Shrink-on-scroll
  let ticking = false;
  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      header?.classList.toggle("scrolled", window.scrollY > 40);
      ticking = false;
    });
  }
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>
