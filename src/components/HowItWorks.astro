---
// Ports features/home/HowItWorks.js — "Líneas y Productos" grid.
// Uses the exact Game-Icons (react-icons/gi) SVGs, imported raw and inlined
// so they inherit currentColor and match the original rendering.
import straightPipe from "../assets/icons/straight-pipe.svg?raw";
import valve from "../assets/icons/valve.svg?raw";
import abstract070 from "../assets/icons/abstract-070.svg?raw";
import brickWall from "../assets/icons/brick-wall.svg?raw";
import largePaintBrush from "../assets/icons/large-paint-brush.svg?raw";
import abstract082 from "../assets/icons/abstract-082.svg?raw";
import hammerNails from "../assets/icons/hammer-nails.svg?raw";
import SectionHeading from "./SectionHeading.astro";

const items = [
  { icon: straightPipe, text: "Tuberías y Accesorios de PVC" }, // GiStraightPipe
  { icon: valve, text: "Abastos, Acoples, Válvulas y Griferias" }, // GiValve
  {
    icon: abstract070,
    text: "Tejas en fibrocemento, Policarbonato, Plásticas y Polipropileno",
  }, // GiAbstract070
  {
    icon: brickWall,
    text: "Sistema liviano drywall y Superboard, Perfileria, Cintas, Masilla, Tornilleria",
  }, // GiBrickWall
  {
    icon: largePaintBrush,
    text: "Pinturas, Brochas, Rodillos, Impermeabilizantes",
  }, // GiLargePaintBrush
  {
    icon: abstract082,
    text: "Lavaplatos en acero, Rejillas Metálicas y PVC",
  }, // GiAbstract082
  { icon: hammerNails, text: "Clavo común y en acero" }, // GiHammerNails
];
---

<section class="w-full pb-4">
  <div class="mx-2 flex max-w-[800px] flex-col items-center sm:mx-auto">
    <SectionHeading class="my-8">Líneas y Productos</SectionHeading>

    <div class="grid grid-cols-[0.2fr_2fr] gap-4 sm:grid-cols-[0.3fr_2fr]">
      {
        items.map((item) => (
          <>
            <div class="m-auto flex h-[50px] w-[50px] items-center justify-center">
              <span class="inline-flex h-8 w-8 [&>svg]:h-full [&>svg]:w-full" set:html={item.icon} />
            </div>
            <div class="flex items-center border-t border-black px-[1px] py-[2px]">
              <p class="text-xl sm:text-2xl">{item.text}</p>
            </div>
          </>
        ))
      }
    </div>
  </div>
</section>
